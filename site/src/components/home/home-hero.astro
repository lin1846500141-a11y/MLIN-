---
import Crosshair from './crosshair.astro'
import HomeSignalPanel from './home-signal-panel.astro'
import HomeMusicPlayer from './home-music-player.astro'

const links = [
  { href: '/', label: 'HOME' },
  { href: '/wiki', label: 'ARCHIVE' },
  { href: '#field-heading', label: 'PROJECTS' },
  { href: '/about', label: 'ABOUT' },
]
---

<section class="home-hero" data-home-hero aria-label="MLINStudio Coastal Signal Archive 首页">
  <img class="home-hero-image" src="/media/hero-f4f229.webp" alt="" width="2100" height="1250" loading="eager" fetchpriority="high" />
  <div class="home-hero-grade" aria-hidden="true"></div>
  <header class="home-hero-topbar">
    <a class="home-hero-brand" href="/" aria-label="MLINStudio 首页">MLINStudio</a>
    <span class="home-hero-slash" aria-hidden="true">/</span>
    <span class="home-hero-brand-note">COASTAL SIGNAL ARCHIVE</span>
    <nav class="home-hero-nav" aria-label="首屏主导航">
      {links.map((link, index) => <a href={link.href} aria-current={index === 0 ? 'page' : undefined}>{link.label}</a>)}
    </nav>
  </header>
  <div class="home-hero-copy">
    <p class="home-hero-label"><span aria-hidden="true">|</span> MLIN / 2026</p>
    <h1 class="home-hero-title">ARCHIVE</h1>
    <p class="home-hero-subtitle">COASTAL SIGNAL ARCHIVE</p>
    <p class="home-hero-tagline">Record the signals by the coast,<br />and keep the moments in time.</p>
    <a class="home-hero-cta" href="/wiki"><span>BUILDER</span><span aria-hidden="true">→</span></a>
    <div class="home-hero-coordinates"><Crosshair /><span>35.2149° N / 139.3467° E</span></div>
  </div>
  <div class="home-hero-panel-slot">
    <HomeSignalPanel current={1} total={1} active="signals" scrollTarget="#studio-position" />
  </div>
  <div class="home-hero-player-slot"><HomeMusicPlayer /></div>
</section>
