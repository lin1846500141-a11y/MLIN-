---
interface Props {
  current?: number
  total?: number
  active?: 'signals' | 'field-notes' | 'archive' | 'projects'
  scrollTarget?: string
}

const {
  current = 1,
  total = 1,
  active = 'signals',
  scrollTarget = '#studio-position',
} = Astro.props

const formatCount = (num: number) => String(Math.max(1, Math.floor(num))).padStart(2, '0')
const currentText = formatCount(current)
const totalText = formatCount(total)

const panelItems: Array<{
  id: NonNullable<Props['active']>
  label: string
  href: string
}> = [
  { id: 'signals', label: 'SIGNALS', href: '#top' },
  { id: 'field-notes', label: 'FIELD NOTES', href: '#field-heading' },
  { id: 'archive', label: 'ARCHIVE', href: '/wiki' },
  { id: 'projects', label: 'PROJECTS', href: '#field-heading' },
]
---

<aside class="signal-panel" data-signal-panel aria-label="Coastal Signal Archive 索引栏">
  <div class="signal-panel-top">
    <p class="signal-panel-brand">
      <span>COASTAL</span>
      <span>SIGNAL</span>
      <span>ARCHIVE</span>
    </p>
  </div>

  <div class="signal-panel-main">
    <div class="signal-panel-counter" aria-label={`当前视觉索引 ${currentText} / ${totalText}`}>
      <strong class="signal-panel-current">{currentText}</strong>
      <span class="signal-panel-total">/ {totalText}</span>
    </div>

    <div class="signal-panel-track" aria-hidden="true">
      <span class="signal-panel-track-dot"></span>
      <span class="signal-panel-track-line"></span>
      <span class="signal-panel-track-tick"></span>
    </div>

    <nav class="signal-panel-nav" aria-label="首屏章节与归档索引">
      {
        panelItems.map((item) => {
          const isActive = item.id === active
          return (
            <a
              class="signal-panel-link"
              href={item.href}
              data-panel-link={item.id}
              data-active={isActive ? 'true' : undefined}
              aria-current={isActive ? 'location' : undefined}
            >
              <span class="signal-panel-marker" aria-hidden="true" />
              <span class="signal-panel-label">{item.label}</span>
            </a>
          )
        })
      }
    </nav>
  </div>

  <div class="signal-panel-facets" aria-hidden="true">
    <span class="signal-panel-facet signal-panel-facet-1"></span>
    <span class="signal-panel-facet signal-panel-facet-2"></span>
    <span class="signal-panel-facet signal-panel-facet-3"></span>
    <span class="signal-panel-facet signal-panel-facet-4"></span>
  </div>

  <a class="signal-panel-scroll" href={scrollTarget} aria-label="向下滚动至档案叙事区">
    <span class="signal-panel-scroll-text">
      <span>SCROLL</span>
      <span>DOWN</span>
    </span>
    <span class="signal-panel-scroll-arrow" aria-hidden="true">
      <svg viewBox="0 0 12 28" width="10" height="24" fill="none">
        <path
          d="M6 1V25M6 25L1.75 20.75M6 25L10.25 20.75"
          stroke="currentColor"
          stroke-width="1.05"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </span>
  </a>

  <div class="signal-panel-foot" aria-hidden="true">
    <strong>{currentText}</strong>
    <span>/ {totalText}</span>
  </div>
</aside>

<style>
  .signal-panel {
    --signal-text: var(--home-text, #f4f6fa);
    --signal-muted: var(--home-muted, #b9c3d3);
    --signal-faint: var(--home-faint, #8b99ae);
    --signal-line: var(--home-line, rgba(225, 234, 248, 0.22));
    --signal-glass-bg: var(
      --home-glass-bg,
      linear-gradient(145deg, rgba(161, 182, 216, 0.18), rgba(8, 19, 36, 0.42))
    );
    --signal-glass-border: var(--home-glass-border, 1px solid rgba(223, 233, 251, 0.28));
    --signal-glass-blur: var(--home-glass-blur, 16px);
    --signal-glass-radius: var(--home-glass-radius, 10px);
    --signal-glass-shadow: var(--home-glass-shadow, inset 0 1px 0 rgba(255, 255, 255, 0.08));
    --signal-font-ui: var(
      --home-font-ui,
      "Helvetica Neue",
      "Inter",
      "Noto Sans SC",
      Arial,
      sans-serif
    );
    --signal-font-display: var(
      --home-font-display,
      Georgia,
      "Times New Roman",
      "Noto Serif SC",
      serif
    );
    --signal-font-mono: var(
      --home-font-mono,
      "SFMono-Regular",
      "Roboto Mono",
      Consolas,
      monospace
    );
    --signal-track-nav: var(--home-track-nav, 0.2em);
    --signal-space-1: var(--home-space-1, 8px);
    --signal-space-2: var(--home-space-2, 16px);
    --signal-px: 0px;
    --signal-py: 0px;

    position: relative;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    min-width: 0;
    overflow: hidden;
    border: var(--signal-glass-border);
    border-top-color: rgba(236, 244, 255, 0.44);
    border-left-color: rgba(232, 241, 255, 0.34);
    border-radius: var(--signal-glass-radius);
    background:
      linear-gradient(
        172deg,
        rgba(146, 172, 210, 0.22) 0%,
        rgba(34, 55, 88, 0.34) 28%,
        rgba(11, 24, 44, 0.56) 66%,
        rgba(6, 15, 30, 0.74) 100%
      ),
      var(--signal-glass-bg);
    box-shadow:
      var(--signal-glass-shadow),
      inset 0 1px 0 rgba(255, 255, 255, 0.24),
      inset 1px 0 0 rgba(235, 244, 255, 0.14),
      inset 0 -1px 0 rgba(4, 11, 22, 0.5),
      0 20px 44px rgba(3, 10, 22, 0.42);
    color: var(--signal-text);
    font-family: var(--signal-font-ui);
    backdrop-filter: blur(var(--signal-glass-blur)) saturate(120%);
    -webkit-backdrop-filter: blur(var(--signal-glass-blur)) saturate(120%);
  }

  /* Directional top-to-bottom ambient light falloff across smoked glass */
  .signal-panel::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    border-radius: inherit;
    background:
      radial-gradient(
        130% 42% at 15% 0%,
        rgba(232, 242, 255, 0.18) 0%,
        rgba(176, 202, 238, 0.06) 45%,
        transparent 75%
      ),
      linear-gradient(
        180deg,
        rgba(255, 255, 255, 0.06) 0%,
        transparent 38%,
        rgba(4, 10, 20, 0.26) 100%
      );
    transform: translate3d(var(--signal-px), var(--signal-py), 0);
    transition: opacity 0.24s ease;
  }

  .signal-panel > * {
    position: relative;
    z-index: 1;
  }

  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .signal-panel {
      background: linear-gradient(
        175deg,
        rgba(22, 41, 70, 0.92) 0%,
        rgba(10, 22, 40, 0.96) 60%,
        rgba(6, 15, 28, 0.98) 100%
      );
    }
  }

  .signal-panel-top {
    padding: var(--signal-space-2) 9px 13px;
    border-bottom: 1px solid rgba(225, 234, 248, 0.2);
  }

  .signal-panel-brand {
    display: flex;
    flex-direction: column;
    gap: 3px;
    margin: 0;
    color: var(--signal-text);
    font-size: 8px;
    font-weight: 400;
    line-height: 1.45;
    letter-spacing: 0.16em;
  }

  .signal-panel-main {
    display: flex;
    flex: 1 1 auto;
    min-height: 0;
    flex-direction: column;
    padding: 16px 8px 12px;
  }

  .signal-panel-counter {
    display: flex;
    align-items: baseline;
    gap: 4px;
    padding-left: 2px;
  }

  .signal-panel-current {
    color: var(--signal-text);
    font-family: var(--signal-font-display);
    font-size: 28px;
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0.02em;
  }

  .signal-panel-total {
    color: var(--signal-faint);
    font-family: var(--signal-font-mono);
    font-size: 8px;
    letter-spacing: 0.12em;
    white-space: nowrap;
  }

  .signal-panel-track {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 7px;
    height: clamp(32px, 5.6vh, 60px);
    margin: 12px 0 12px 4px;
  }

  .signal-panel-track-dot {
    width: 4px;
    height: 4px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--signal-text);
    box-shadow: 0 0 8px rgba(244, 246, 250, 0.82);
  }

  .signal-panel-track-line {
    width: 1px;
    flex: 1 1 auto;
    background: linear-gradient(
      180deg,
      rgba(244, 246, 250, 0.72) 0%,
      rgba(225, 234, 248, 0.24) 100%
    );
  }

  .signal-panel-track-tick {
    width: 5px;
    height: 1px;
    flex-shrink: 0;
    background: rgba(225, 234, 248, 0.36);
  }

  .signal-panel-nav {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-top: 2px;
  }

  .signal-panel-link {
    position: relative;
    display: flex;
    align-items: center;
    gap: 5px;
    width: 100%;
    min-width: 0;
    min-height: 44px;
    padding: 4px 2px;
    border-radius: 4px;
    color: var(--signal-muted);
    font-size: clamp(7px, 0.54vw, 8px);
    line-height: 1.28;
    letter-spacing: 0.08em;
    text-decoration: none;
    transition:
      color 0.18s ease,
      background-color 0.18s ease,
      transform 0.12s ease;
  }

  .signal-panel-link:hover {
    color: var(--signal-text);
    background: rgba(225, 234, 248, 0.07);
  }

  .signal-panel-link:active {
    transform: translateY(1px);
  }

  .signal-panel-link[data-active='true'] {
    color: var(--signal-text);
    font-weight: 500;
  }

  .signal-panel-marker {
    width: 4px;
    height: 4px;
    flex-shrink: 0;
    border: 1px solid rgba(185, 195, 211, 0.58);
    border-radius: 1px;
    background: transparent;
    transition:
      border-color 0.18s ease,
      background-color 0.18s ease,
      box-shadow 0.18s ease,
      transform 0.18s ease;
  }

  .signal-panel-link:hover .signal-panel-marker {
    border-color: rgba(244, 246, 250, 0.85);
  }

  .signal-panel-link[data-active='true'] .signal-panel-marker {
    border-color: var(--signal-text);
    background: var(--signal-text);
    box-shadow: 0 0 7px rgba(244, 246, 250, 0.65);
  }

  .signal-panel-label {
    min-width: 0;
    white-space: normal;
    overflow-wrap: break-word;
  }

  /* Quiet folded geometric lower texture (CSS-only planes) */
  .signal-panel-facets {
    position: relative;
    height: clamp(84px, 15.5vh, 158px);
    flex-shrink: 0;
    border-top: 1px solid rgba(225, 234, 248, 0.18);
    border-bottom: 1px solid rgba(225, 234, 248, 0.22);
    background: linear-gradient(
      175deg,
      rgba(16, 33, 60, 0.28) 0%,
      rgba(7, 17, 34, 0.56) 100%
    );
    overflow: hidden;
  }

  .signal-panel-facet {
    position: absolute;
    inset: 0;
    pointer-events: none;
    transition: transform 0.24s ease-out;
  }

  .signal-panel-facet-1 {
    clip-path: polygon(0 0, 100% 18%, 42% 62%, 0 46%);
    background: linear-gradient(
      138deg,
      rgba(220, 234, 252, 0.14) 0%,
      rgba(116, 148, 192, 0.05) 68%,
      rgba(8, 19, 36, 0.18) 100%
    );
  }

  .signal-panel-facet-2 {
    clip-path: polygon(100% 18%, 100% 72%, 42% 62%);
    background: linear-gradient(
      215deg,
      rgba(196, 218, 248, 0.13) 0%,
      rgba(38, 64, 104, 0.18) 55%,
      rgba(6, 15, 30, 0.42) 100%
    );
  }

  .signal-panel-facet-3 {
    clip-path: polygon(0 46%, 42% 62%, 78% 100%, 0 100%);
    background: linear-gradient(
      34deg,
      rgba(6, 14, 28, 0.48) 0%,
      rgba(148, 178, 220, 0.12) 64%,
      rgba(224, 236, 252, 0.09) 100%
    );
  }

  .signal-panel-facet-4 {
    clip-path: polygon(42% 62%, 100% 72%, 100% 100%, 78% 100%);
    background: linear-gradient(
      152deg,
      rgba(226, 238, 254, 0.14) 0%,
      rgba(22, 42, 74, 0.26) 52%,
      rgba(6, 15, 30, 0.44) 100%
    );
    transform: translate3d(calc(var(--signal-px) * -0.5), calc(var(--signal-py) * -0.5), 0);
  }

  .signal-panel-scroll {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--signal-space-1);
    min-height: 44px;
    padding: 13px 9px;
    border-bottom: 1px solid rgba(225, 234, 248, 0.18);
    color: var(--signal-text);
    font-size: 8px;
    line-height: 1.4;
    letter-spacing: 0.16em;
    text-decoration: none;
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      transform 0.12s ease;
  }

  .signal-panel-scroll:hover {
    background: rgba(225, 234, 248, 0.08);
  }

  .signal-panel-scroll:active {
    transform: translateY(1px);
  }

  .signal-panel-scroll-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .signal-panel-scroll-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--signal-muted);
    transition:
      transform 0.22s ease,
      color 0.22s ease;
  }

  .signal-panel-scroll:hover .signal-panel-scroll-arrow {
    color: var(--signal-text);
    transform: translateY(2px);
  }

  .signal-panel-foot {
    display: flex;
    align-items: baseline;
    gap: 4px;
    padding: 12px 9px;
    color: var(--signal-muted);
    font-family: var(--signal-font-mono);
    font-size: 9px;
    letter-spacing: 0.12em;
  }

  .signal-panel-foot strong {
    color: var(--signal-text);
    font-weight: 600;
  }

  .signal-panel-foot span {
    color: var(--signal-faint);
    font-size: 8px;
  }

  .signal-panel a:focus-visible {
    outline: 2px solid var(--signal-text);
    outline-offset: -2px;
    background: rgba(225, 234, 248, 0.12);
    color: var(--signal-text);
  }

  @media (max-height: 760px) {
    .signal-panel-top {
      padding: 12px 9px 10px;
    }

    .signal-panel-main {
      padding: 12px 8px 8px;
    }

    .signal-panel-facets {
      height: 72px;
    }

    .signal-panel-track {
      height: 28px;
      margin: 8px 0 8px 4px;
    }

    .signal-panel-scroll {
      padding: 10px 9px;
    }

    .signal-panel-foot {
      padding: 10px 9px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .signal-panel::before,
    .signal-panel-facet,
    .signal-panel-link,
    .signal-panel-marker,
    .signal-panel-scroll,
    .signal-panel-scroll-arrow {
      transition: none;
      transform: none;
    }

    .signal-panel-scroll:hover .signal-panel-scroll-arrow {
      transform: none;
    }
  }
</style>

<script>
  const initSignalPanels = () => {
    const panels = document.querySelectorAll<HTMLElement>('[data-signal-panel]')
    const canParallax = () =>
      window.matchMedia('(pointer: fine) and (hover: hover)').matches &&
      !window.matchMedia('(prefers-reduced-motion: reduce)').matches

    panels.forEach((panel) => {
      if (panel.dataset.panelReady === 'true') return
      panel.dataset.panelReady = 'true'

      const controller = new AbortController()
      const { signal } = controller

      const links = Array.from(panel.querySelectorAll<HTMLAnchorElement>('[data-panel-link]'))
      links.forEach((link) => {
        link.addEventListener(
          'click',
          () => {
            const href = link.getAttribute('href') || ''
            if (!href.startsWith('#')) return
            links.forEach((item) => {
              if (item === link) {
                item.dataset.active = 'true'
                item.setAttribute('aria-current', 'location')
              } else {
                delete item.dataset.active
                item.removeAttribute('aria-current')
              }
            })
          },
          { signal },
        )
      })

      let rafId = 0
      let targetX = 0
      let targetY = 0

      const commitParallax = () => {
        rafId = 0
        panel.style.setProperty('--signal-px', `${targetX.toFixed(2)}px`)
        panel.style.setProperty('--signal-py', `${targetY.toFixed(2)}px`)
      }

      const scheduleParallax = (x: number, y: number) => {
        targetX = x
        targetY = y
        if (!rafId) {
          rafId = requestAnimationFrame(commitParallax)
        }
      }

      panel.addEventListener(
        'pointermove',
        (event) => {
          if (!canParallax()) return
          const rect = panel.getBoundingClientRect()
          if (rect.width <= 0 || rect.height <= 0) return
          const nx = (event.clientX - rect.left) / rect.width - 0.5
          const ny = (event.clientY - rect.top) / rect.height - 0.5
          scheduleParallax(nx * 3, ny * 3)
        },
        { signal, passive: true },
      )

      panel.addEventListener(
        'pointerleave',
        () => {
          scheduleParallax(0, 0)
        },
        { signal },
      )

      const cleanup = () => {
        if (rafId) {
          cancelAnimationFrame(rafId)
          rafId = 0
        }
        panel.style.removeProperty('--signal-px')
        panel.style.removeProperty('--signal-py')
        controller.abort()
        delete panel.dataset.panelReady
      }

      document.addEventListener('astro:before-swap', cleanup, { once: true, signal })
      window.addEventListener('pagehide', cleanup, { once: true, signal })
    })
  }

  initSignalPanels()
  document.addEventListener('astro:page-load', initSignalPanels)
</script>
