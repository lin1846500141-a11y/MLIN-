---
import 'lenis/dist/lenis.css'
import Crosshair from './crosshair.astro'
import HomeHero from './home-hero.astro'
import HomeFieldNotes from './home-field-notes.astro'

const routeLinks = [
  {
    no: '01',
    href: '/wiki',
    title: 'WIKI',
    zh: '索引与笔记',
    desc: '持续整理的技术、视觉与实践记录。',
  },
  {
    no: '02',
    href: '/guestbook',
    title: 'GUESTBOOK',
    zh: '留下坐标',
    desc: '一块开放的留言区域，记录偶然经过的人。',
  },
  {
    no: '03',
    href: '/about',
    title: 'ABOUT',
    zh: '个人档案',
    desc: '关于经历、能力，以及正在学习的方向。',
  },
]
---

<main class="home" data-home-redesign id="top">
  <HomeHero />

  <aside class="home-progress-rail" aria-hidden="true">
    <span class="home-progress-kicker">FIELD INDEX</span>
    <div class="home-progress-value">
      <strong class="home-progress-current">02</strong>
      <span>/ 04</span>
    </div>
    <span class="home-progress-track">
      <i class="home-progress-fill"></i>
    </span>
    <span class="home-progress-caption">SCROLL<br />ARCHIVE</span>
  </aside>

  <section class="manifesto-section" id="studio-position">
    <div class="manifesto-meta">
      <span>02 — STUDIO POSITION</span>
      <span>BUILD / OBSERVE / RECORD</span>
      <span>UPDATED 2026</span>
    </div>

    <div class="manifesto-copy">
      <p class="manifesto-kicker">A PERSONAL INDEX BETWEEN</p>
      <h2>
        <span class="manifesto-line"><span>SIGNAL</span></span>
        <span class="manifesto-line"><span>&amp; SEA.</span></span>
      </h2>
      <div class="manifesto-note">
        <Crosshair />
        <p>
          不是一个静止的作品集，而是一份可以滚动、检索、继续补写的个人档案。
          蓝色来自夏天和海面，网格则负责把自由的内容重新归档。
        </p>
      </div>
    </div>
    <div class="manifesto-current">CURRENT / 001</div>
  </section>

  <HomeFieldNotes />

  <section class="routes-section" aria-labelledby="routes-heading">
    <div class="routes-heading">
      <span>04 — CONTINUE READING</span>
      <h2 id="routes-heading">OPEN THE ARCHIVE</h2>
      <p>选择一个入口，继续向内浏览。</p>
    </div>

    <div class="route-list">
      {
        routeLinks.map((item) => (
          <a class="route-row" href={item.href}>
            <span class="route-no">{item.no}</span>
            <div class="route-title">
              <strong data-long={item.title.length > 6 ? '' : undefined}>{item.title}</strong>
              <i>{item.zh}</i>
            </div>
            <p>{item.desc}</p>
            <b class="route-arrow">↗</b>
          </a>
        ))
      }
    </div>
  </section>

  <footer class="home-footer">
    <div>
      <span>MLIN WIKI / DIGITAL FIELD LOG</span>
      <span>MADE IN GUANGDONG · CHINA</span>
    </div>
    <p>MLINStudio</p>
    <div>
      <span>COASTAL EDITION 01</span>
      <a href="#top">BACK TO TOP ↑</a>
    </div>
  </footer>
</main>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  import Lenis from 'lenis'

  gsap.registerPlugin(ScrollTrigger)
  const home = document.querySelector<HTMLElement>('.home[data-home-redesign]')
  if (home) {
    const motion = gsap.matchMedia()
    motion.add('(prefers-reduced-motion: no-preference)', () => {
      const hoverCleanups: Array<() => void> = []
      const lenis = new Lenis({
        duration: 1.05, lerp: 0.09, smoothWheel: true,
        wheelMultiplier: 0.9, touchMultiplier: 1.05, anchors: true,
      })
      lenis.on('scroll', ScrollTrigger.update)
      const tick = (time: number) => lenis.raf(time * 1000)
      gsap.ticker.add(tick)
      gsap.ticker.lagSmoothing(0)

      gsap.from('.manifesto-line span', {
        yPercent: 110,
        stagger: 0.08,
        duration: 1.15,
        ease: 'power4.out',
        scrollTrigger: {
          trigger: '.manifesto-copy',
          start: 'top 72%',
        },
      })

      gsap.utils.toArray<HTMLElement>('.field-plate').forEach((plate, index) => {
        gsap.from(plate, {
          y: 90,
          opacity: 0,
          rotate: index % 2 === 0 ? -1.2 : 1.2,
          duration: 1.1,
          ease: 'power3.out',
          clearProps: 'transform,opacity',
          scrollTrigger: {
            trigger: plate,
            start: 'top 88%',
          },
        })

        const enter = () => { gsap.to(plate, { y: -8, duration: 0.35, ease: 'power4.out', overwrite: 'auto' }) }
        const leave = () => { gsap.to(plate, { y: 0, duration: 0.35, ease: 'power4.out', overwrite: 'auto' }) }
        plate.addEventListener('mouseenter', enter)
        plate.addEventListener('mouseleave', leave)
        hoverCleanups.push(() => {
          plate.removeEventListener('mouseenter', enter)
          plate.removeEventListener('mouseleave', leave)
          gsap.killTweensOf(plate)
        })
      })

      gsap.utils.toArray<HTMLElement>('.route-row').forEach((row) => {
        gsap.from(row, {
          clipPath: 'inset(0 100% 0 0)',
          duration: 1,
          ease: 'power3.inOut',
          clearProps: 'clipPath',
          scrollTrigger: { trigger: row, start: 'top 90%' },
        })
      })

      const progressCurrent = home.querySelector<HTMLElement>('.home-progress-current')
      const progressSections = [
        { selector: '.manifesto-section', number: '02' },
        { selector: '.field-section', number: '03' },
        { selector: '.routes-section', number: '04' },
      ]

      gsap.fromTo(
        '.home-progress-rail',
        { autoAlpha: 0, x: 18 },
        {
          autoAlpha: 1,
          x: 0,
          duration: 0.5,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: '.manifesto-section',
            start: 'top 86%',
            toggleActions: 'play none none reverse',
          },
        },
      )

      gsap.fromTo(
        '.home-progress-fill',
        { scaleY: 0 },
        {
          scaleY: 1,
          ease: 'none',
          scrollTrigger: {
            trigger: '.manifesto-section',
            start: 'top bottom',
            endTrigger: '.routes-section',
            end: 'bottom 55%',
            scrub: 0.35,
          },
        },
      )

      gsap.to('.home-progress-rail', {
        autoAlpha: 0,
        y: -12,
        duration: 0.35,
        ease: 'power2.out',
        scrollTrigger: {
          trigger: '.home-footer',
          start: 'top 88%',
          toggleActions: 'play none none reverse',
        },
      })

      progressSections.forEach(({ selector, number }) => {
        ScrollTrigger.create({
          trigger: selector,
          start: 'top 56%',
          end: 'bottom 56%',
          onEnter: () => {
            if (progressCurrent) progressCurrent.textContent = number
          },
          onEnterBack: () => {
            if (progressCurrent) progressCurrent.textContent = number
          },
        })
      })
      return () => {
        hoverCleanups.forEach((cleanup) => cleanup())
        gsap.ticker.remove(tick)
        lenis.destroy()
      }
    }, home)
    document.addEventListener('astro:before-swap', () => motion.revert(), { once: true })
  }
</script>
