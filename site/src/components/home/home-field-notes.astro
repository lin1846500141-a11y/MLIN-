---
import Crosshair from './crosshair.astro'
import { capabilityNotes } from '../../lib/archive-data'

export interface FieldNoteItem {
  index: string
  title: string
  body: string
  kicker: string
  meta: string
  image?: { src: string; alt: string; width: number; height: number }
}

interface Props {
  items?: FieldNoteItem[]
  anchorId?: string
  title?: string
  eyebrow?: string
  description?: string
}

const defaultItems: FieldNoteItem[] = capabilityNotes.map(({ no, ...note }, i) => ({
  ...note,
  index: no,
  ...(i === 0
    ? {
        image: {
          src: '/media/coastal-hero.webp',
          alt: '',
          width: 1672,
          height: 941,
        },
      }
    : {}),
}))

const {
  items = defaultItems,
  anchorId = 'field-heading',
  title = 'FIELD NOTES',
  eyebrow = '03 — SELECTED FIELDS',
  description = 'THREE WAYS OF MAKING',
} = Astro.props
---

<section class="field-section field-paper" data-field-notes aria-labelledby={anchorId}>
  <div class="field-paper-inner">
    <header class="field-header field-paper-header">
      <div class="field-paper-kicker">
        <span>{eyebrow}</span>
        <p>{description}</p>
      </div>
      <h2 id={anchorId}>{title}</h2>
      <span class="field-paper-crosshair-slot field-paper-crosshair-slot--header">
        <Crosshair />
      </span>
    </header>

    <div class="field-plates field-paper-plates">
      {
        items.map((item, idx) => {
          const variant = (idx % 3) + 1
          const hasImage = Boolean(item.image)
          const titleLines = item.title.split('\n').filter((line) => line.length > 0)

          return (
            <article
              class={`field-plate field-paper-plate field-paper-plate--${variant}`}
              data-has-image={hasImage ? 'true' : 'false'}
            >
              {variant === 2 && <span class="field-paper-caliper" aria-hidden="true" />}
              {variant === 3 && <span class="field-paper-seal" aria-hidden="true" />}

              <div class="field-paper-topline">
                <span>{item.kicker}</span>
                <b>{item.index}</b>
              </div>

              {item.image && (
                <figure class="field-paper-media" aria-hidden="true">
                  <img
                    src={item.image.src}
                    alt={item.image.alt}
                    width={item.image.width}
                    height={item.image.height}
                    loading="lazy"
                  />
                </figure>
              )}

              <div class="field-paper-content">
                <h3>
                  {titleLines.map((line) => (
                    <span>{line}</span>
                  ))}
                </h3>
                <p>{item.body}</p>
              </div>

              <footer class="field-paper-foot">
                <span>{item.meta}</span>
                <span class="field-paper-crosshair-slot field-paper-crosshair-slot--foot">
                  <Crosshair />
                </span>
              </footer>
            </article>
          )
        })
      }
    </div>
  </div>
</section>

<style>
  .field-section.field-paper {
    --field-paper: var(--home-paper, #f2f0e9);
    --field-paper-card: #f8f6f0;
    --field-paper-linen: #eae6da;
    --field-paper-mist: #e8ebe6;
    --field-ink: var(--home-paper-ink, #202c38);
    --field-ink-soft: rgba(32, 44, 56, 0.78);
    --field-ink-faint: rgba(32, 44, 56, 0.56);
    --field-line: var(--home-paper-line, rgba(32, 44, 56, 0.2));
    --field-accent: var(--home-accent, #f16c75);
    --field-font-display: var(
      --home-font-display,
      Georgia,
      "Times New Roman",
      "Noto Serif SC",
      serif
    );
    --field-font-ui: var(
      --home-font-ui,
      "Helvetica Neue",
      "Inter",
      "Noto Sans SC",
      Arial,
      sans-serif
    );
    --field-font-mono: var(
      --home-font-mono,
      "SFMono-Regular",
      "Roboto Mono",
      Consolas,
      monospace
    );
    --field-edge-x: var(--home-copy-left, clamp(32px, 4.9vw, 82px));
    --field-section-space: var(--home-section-space, clamp(64px, 9vw, 144px));
    --field-px: 0px;
    --field-py: 0px;

    position: relative;
    z-index: 4;
    width: 100%;
    min-width: 0;
    min-height: auto;
    padding: var(--field-section-space) var(--field-edge-x);
    color: var(--field-ink);
    font-family: var(--field-font-ui);
    background:
      linear-gradient(180deg, #f5f3ec 0%, var(--field-paper) 48%, #ebe8de 100%);
    border-top: 1px solid var(--field-line);
    border-bottom: 1px solid var(--field-line);
  }

  .field-paper-inner {
    max-width: 1500px;
    margin: 0 auto;
  }

  .field-section.field-paper .field-header.field-paper-header {
    display: grid;
    grid-template-columns: minmax(180px, 1fr) 2fr auto;
    align-items: end;
    gap: 24px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--field-ink);
  }

  .field-section.field-paper .field-paper-kicker > span,
  .field-section.field-paper .field-paper-kicker > p {
    margin: 0;
    font-family: var(--field-font-mono);
    font-size: 10px;
    line-height: 1.6;
    letter-spacing: 0.14em;
    color: var(--field-ink-faint);
  }

  .field-section.field-paper .field-paper-kicker > p {
    margin-top: 6px;
    color: var(--field-ink);
  }

  .field-section.field-paper .field-header.field-paper-header h2 {
    margin: 0;
    color: var(--field-ink);
    font-family: var(--field-font-display);
    font-size: clamp(36px, 4.7vw, 78px);
    font-weight: 400;
    line-height: 1.06;
    letter-spacing: -0.025em;
  }

  .field-section.field-paper .field-header.field-paper-header .field-paper-crosshair-slot--header {
    display: inline-flex;
    align-items: center;
    margin: 0 4px 4px 20px;
    color: var(--field-ink);
  }

  .field-section.field-paper .field-plates.field-paper-plates {
    display: grid;
    width: 100%;
    max-width: 1500px;
    margin: clamp(40px, 5vw, 64px) auto 0;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-items: start;
    gap: clamp(16px, 1.8vw, 28px);
  }

  .field-section.field-paper .field-plate.field-paper-plate {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 560px;
    margin: 0;
    padding: clamp(20px, 2vw, 30px);
    overflow: hidden;
    border: 1px solid var(--field-line);
    border-radius: 2px;
    background: var(--field-paper-card);
    color: var(--field-ink);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.85),
      0 10px 26px rgba(32, 44, 56, 0.05);
    transition:
      border-color 0.28s ease,
      box-shadow 0.28s ease;
  }

  /* Subtle paper specular highlight sweep on hover; avoids root transform conflict with GSAP */
  .field-section.field-paper .field-plate.field-paper-plate::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    background: linear-gradient(
      115deg,
      transparent 18%,
      rgba(255, 255, 255, 0.36) 48%,
      transparent 78%
    );
    transform: translateX(-115%);
    transition: transform 0.72s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .field-section.field-paper .field-plate.field-paper-plate:hover {
    border-color: rgba(32, 44, 56, 0.44);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.92),
      0 18px 36px rgba(32, 44, 56, 0.1);
  }

  .field-section.field-paper .field-plate.field-paper-plate:hover::after {
    transform: translateX(115%);
  }

  .field-section.field-paper .field-paper-plate--1 {
    grid-column: span 5;
    min-height: 620px;
    background: linear-gradient(170deg, #faf8f2 0%, var(--field-paper-card) 100%);
  }

  .field-section.field-paper .field-paper-plate--2 {
    grid-column: span 3;
    margin-top: clamp(32px, 5.5vh, 68px);
    min-height: 520px;
    background: linear-gradient(165deg, #efece2 0%, var(--field-paper-linen) 100%);
  }

  .field-section.field-paper .field-paper-plate--3 {
    grid-column: span 4;
    margin-top: clamp(12px, 2.5vh, 32px);
    min-height: 540px;
    background:
      repeating-linear-gradient(
        180deg,
        transparent 0,
        transparent 31px,
        rgba(32, 44, 56, 0.035) 31px,
        rgba(32, 44, 56, 0.035) 32px
      ),
      linear-gradient(170deg, #eef1ec 0%, var(--field-paper-mist) 100%);
  }

  /* Plate 2 restrained architectural compass rings */
  .field-paper-caliper {
    position: absolute;
    top: 14%;
    right: -18%;
    width: 68%;
    aspect-ratio: 1;
    border: 1px solid rgba(32, 44, 56, 0.14);
    border-radius: 50%;
    box-shadow:
      0 0 0 24px rgba(32, 44, 56, 0.02),
      0 0 0 48px rgba(32, 44, 56, 0.015);
    pointer-events: none;
  }

  /* Plate 3 subtle archival folio disc */
  .field-paper-seal {
    position: absolute;
    top: 15%;
    right: 9%;
    width: 36%;
    aspect-ratio: 1;
    border: 1px solid rgba(32, 44, 56, 0.14);
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(241, 108, 117, 0.18) 0%,
      rgba(241, 108, 117, 0.08) 58%,
      transparent 72%
    );
    pointer-events: none;
  }

  .field-paper-topline,
  .field-paper-media,
  .field-paper-content,
  .field-paper-foot {
    position: relative;
    z-index: 2;
  }

  .field-paper-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 13px;
    border-bottom: 1px solid var(--field-line);
    font-family: var(--field-font-mono);
    font-size: 10px;
    line-height: 1.4;
    letter-spacing: 0.12em;
    color: var(--field-ink-faint);
  }

  .field-paper-topline b {
    font-weight: 600;
    color: var(--field-accent);
  }

  .field-paper-plate--3 .field-paper-topline b {
    color: var(--field-ink);
  }

  .field-paper-media {
    margin: 20px 0 0;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid rgba(32, 44, 56, 0.18);
    background: #d8d5cc;
  }

  .field-paper-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 24% center;
    filter: contrast(1.02) saturate(0.92);
    transform: translate3d(var(--field-px), var(--field-py), 0) scale(1.02);
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .field-section.field-paper .field-plate.field-paper-plate:hover .field-paper-media img {
    transform: translate3d(var(--field-px), var(--field-py), 0) scale(1.05);
  }

  .field-paper-content {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    justify-content: flex-end;
    padding-top: 28px;
  }

  .field-section.field-paper .field-plate.field-paper-plate h3 {
    margin: 0 0 18px;
    color: var(--field-ink);
    font-family: var(--field-font-display);
    font-size: clamp(28px, 2.9vw, 50px);
    font-weight: 400;
    line-height: 1.06;
    letter-spacing: -0.025em;
    overflow-wrap: anywhere;
  }

  .field-section.field-paper .field-plate.field-paper-plate h3 span {
    display: block;
  }

  .field-section.field-paper .field-plate.field-paper-plate p {
    max-width: 36em;
    margin: 0 0 26px;
    color: var(--field-ink-soft);
    font-size: 14px;
    line-height: 1.85;
  }

  .field-section.field-paper .field-plate.field-paper-plate .field-paper-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 16px;
    border-top: 1px solid var(--field-line);
    color: var(--field-ink-faint);
    font-family: var(--field-font-mono);
    font-size: 10px;
    line-height: 1.4;
    letter-spacing: 0.12em;
  }

  .field-section.field-paper .field-paper-foot .field-paper-crosshair-slot--foot {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    color: var(--field-ink);
    transform: scale(0.78);
    transform-origin: right center;
  }

  @media (max-width: 1120px) {
    .field-section.field-paper .field-plates.field-paper-plates {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
    }

    .field-section.field-paper .field-paper-plate--1 {
      grid-column: 1 / -1;
      min-height: 440px;
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      grid-template-rows: auto 1fr auto;
      column-gap: 28px;
      align-items: start;
    }

    .field-section.field-paper .field-paper-plate--1 .field-paper-topline {
      grid-column: 1 / -1;
    }

    .field-section.field-paper .field-paper-plate--1 .field-paper-media {
      grid-column: 1;
      grid-row: 2 / 4;
      margin-top: 22px;
      align-self: stretch;
      aspect-ratio: auto;
      min-height: 260px;
    }

    .field-section.field-paper .field-paper-plate--1 .field-paper-content {
      grid-column: 2;
      grid-row: 2;
      padding-top: 22px;
    }

    .field-section.field-paper .field-paper-plate--1 .field-paper-foot {
      grid-column: 2;
      grid-row: 3;
      align-self: end;
    }

    .field-section.field-paper .field-paper-plate--2,
    .field-section.field-paper .field-paper-plate--3 {
      grid-column: span 1;
      margin-top: 0;
      min-height: 420px;
    }
  }

  @media (max-width: 899px) {
    .field-section.field-paper {
      --field-edge-x: 24px;
    }

    .field-section.field-paper .field-header.field-paper-header {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 20px 12px;
    }

    .field-section.field-paper .field-header.field-paper-header h2 {
      grid-row: 2;
      grid-column: 1 / -1;
    }

    .field-section.field-paper .field-header.field-paper-header .field-paper-crosshair-slot--header {
      margin: 0 2px 0 12px;
    }
  }

  @media (max-width: 720px) {
    .field-section.field-paper .field-plates.field-paper-plates {
      grid-template-columns: 1fr;
      margin-top: 32px;
    }

    .field-section.field-paper .field-paper-plate--1 {
      display: flex;
      flex-direction: column;
      grid-column: span 1;
    }

    .field-section.field-paper .field-paper-plate--1 .field-paper-media {
      min-height: 0;
      aspect-ratio: 16 / 9;
      margin-top: 18px;
    }

    .field-section.field-paper .field-plate.field-paper-plate {
      min-height: auto;
      padding: 20px 18px;
    }

    .field-section.field-paper .field-paper-content {
      padding-top: 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .field-section.field-paper .field-plate.field-paper-plate,
    .field-section.field-paper .field-plate.field-paper-plate::after,
    .field-paper-media img {
      transition: none;
    }

    .field-section.field-paper .field-plate.field-paper-plate:hover::after {
      transform: translateX(-115%);
    }

    .field-paper-media img,
    .field-section.field-paper .field-plate.field-paper-plate:hover .field-paper-media img {
      transform: none;
    }
  }
</style>

<script>
  const initFieldNotes = () => {
    const sections = document.querySelectorAll<HTMLElement>('[data-field-notes]')
    const canParallax = () =>
      window.matchMedia('(pointer: fine) and (hover: hover)').matches &&
      !window.matchMedia('(prefers-reduced-motion: reduce)').matches

    sections.forEach((section) => {
      if (section.dataset.fieldReady === 'true') return
      section.dataset.fieldReady = 'true'

      const controller = new AbortController()
      const { signal } = controller
      const imagePlates = Array.from(
        section.querySelectorAll<HTMLElement>('[data-has-image="true"]'),
      )

      imagePlates.forEach((plate) => {
        let rafId = 0
        let targetX = 0
        let targetY = 0

        const commit = () => {
          rafId = 0
          plate.style.setProperty('--field-px', `${targetX.toFixed(2)}px`)
          plate.style.setProperty('--field-py', `${targetY.toFixed(2)}px`)
        }

        const schedule = (x: number, y: number) => {
          targetX = x
          targetY = y
          if (!rafId) {
            rafId = requestAnimationFrame(commit)
          }
        }

        plate.addEventListener(
          'pointermove',
          (event) => {
            if (!canParallax()) return
            const rect = plate.getBoundingClientRect()
            if (rect.width <= 0 || rect.height <= 0) return
            const nx = (event.clientX - rect.left) / rect.width - 0.5
            const ny = (event.clientY - rect.top) / rect.height - 0.5
            schedule(nx * -3, ny * -3)
          },
          { signal, passive: true },
        )

        plate.addEventListener(
          'pointerleave',
          () => {
            schedule(0, 0)
          },
          { signal },
        )

        const stopRaf = () => {
          if (rafId) {
            cancelAnimationFrame(rafId)
            rafId = 0
          }
          plate.style.removeProperty('--field-px')
          plate.style.removeProperty('--field-py')
        }

        signal.addEventListener('abort', stopRaf, { once: true })
      })

      const cleanup = () => {
        controller.abort()
        delete section.dataset.fieldReady
      }

      document.addEventListener('astro:before-swap', cleanup, { once: true, signal })
      window.addEventListener('pagehide', cleanup, { once: true, signal })
    })
  }

  initFieldNotes()
  document.addEventListener('astro:page-load', initFieldNotes)
</script>
