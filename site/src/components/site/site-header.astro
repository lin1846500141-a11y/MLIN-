---
// 全站统一顶栏（与首页 MLINStudio + 贯穿细线 + HOME / ARCHIVE / PROJECTS / ABOUT 完全一致）
// 首页（/）因内嵌在 hero-stage 动画层中，此处仅在非首页渲染。
const topNavLinks = [
  { href: '/', label: 'HOME' },
  { href: '/wiki', label: 'ARCHIVE' },
  { href: '/#field-heading', label: 'PROJECTS' },
  { href: '/about', label: 'ABOUT' },
]

const normalize = (path: string) => path.replace(/\/+$/, '') || '/'
const pathname = normalize(Astro.url.pathname)

const isActive = (href: string) => {
  if (href.startsWith('/#')) return false
  const norm = normalize(href)
  if (norm === '/') return pathname === '/'
  return pathname === norm || pathname.startsWith(`${norm}/`)
}
---

{
  pathname !== '/' && (
    <header class="mlin-top-dock">
      <a class="hero-brand" href="/" aria-label="MLINStudio 首页">
        MLINStudio
      </a>
      <span class="hero-top-rule" aria-hidden="true" />
      <nav class="hero-topnav" aria-label="主导航">
        {topNavLinks.map((item) => (
          <a href={item.href} class={isActive(item.href) ? 'is-active' : undefined}>
            <span>{item.label}</span>
          </a>
        ))}
      </nav>
    </header>
  )
}
