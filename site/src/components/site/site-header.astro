---
// 站点页头 —— 自 frontend/components/site/site-header.tsx 平移（M0）
// 差异：React/motion 改 vanilla TS；首页（/）不渲染页头，与旧站行为一致。
const navItems = [
  { href: '/', label: 'Index' },
  { href: '/wiki', label: 'Wiki' },
  { href: '/guestbook', label: 'Guestbook' },
  { href: '/about', label: 'About' },
]

const normalize = (path: string) => path.replace(/\/+$/, '') || '/'
const pathname = normalize(Astro.url.pathname)
---

{
  pathname !== '/' && (
    <header class="site-header">
      <a class="site-name" href="/" aria-label="MLIN Wiki 首页">
        <span>MLIN</span> Wiki
      </a>

      <nav class="desktop-nav" aria-label="主导航">
        {navItems.map((item) => (
          <a href={item.href} class={normalize(item.href) === pathname ? 'is-current' : undefined}>
            {item.label}
          </a>
        ))}
      </nav>

      <div class="header-record">
        <i /> FIELD LOG · 2026
      </div>

      <button class="menu-toggle" type="button" aria-label="打开菜单" aria-expanded="false">
        <span>MENU</span>
        <b>+</b>
      </button>

      <nav class="mobile-nav" aria-label="移动端导航">
        {navItems.map((item, index) => (
          <a href={item.href}>
            <span>0{index + 1}</span>
            {item.label}
          </a>
        ))}
      </nav>
    </header>
  )
}

<style>
  /* 移动端菜单开合 —— 原 motion/react 的 clipPath 动画改为 CSS 过渡（等价参数）。
     收起时 visibility 延迟隐藏，等价于旧版 AnimatePresence 卸载语义（不可聚焦）。 */
  .mobile-nav {
    clip-path: inset(0 0 100% 0);
    visibility: hidden;
    transition:
      clip-path 450ms cubic-bezier(0.76, 0, 0.24, 1),
      visibility 0s linear 450ms;
  }

  .mobile-nav.is-open {
    clip-path: inset(0 0 0% 0);
    visibility: visible;
    transition: clip-path 450ms cubic-bezier(0.76, 0, 0.24, 1);
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.site-header')
  const toggle = header?.querySelector<HTMLButtonElement>('.menu-toggle')
  const nav = header?.querySelector<HTMLElement>('.mobile-nav')

  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('is-open') ?? false
    toggle.setAttribute('aria-expanded', String(open))
    toggle.setAttribute('aria-label', open ? '关闭菜单' : '打开菜单')
    const label = toggle.querySelector('span')
    const mark = toggle.querySelector('b')
    if (label) label.textContent = open ? 'CLOSE' : 'MENU'
    if (mark) mark.textContent = open ? '×' : '+'
  })
</script>
