---
// /wiki 列表 —— 自 frontend/components/wiki/wiki-grid.tsx 平移（M1）。
// M4：卡片改为构建期直出静态 HTML（数据源 src/content/wiki/*.md），每张卡片链接到
// /wiki/[slug]/ 详情页；无需再 fetch，搜索引擎可直接抓取。标签 + 关键词筛选保留为
// 约 1KB 的 vanilla 脚本，仅切换卡片显隐。DOM 结构与类名与旧站一致。
import { getWikiEntries } from '../../lib/wiki'

const entries = await getWikiEntries()
const tags = ['ALL', ...new Set(entries.map((e) => e.data.tags[0].toUpperCase()))]
const pad = (value: number) => String(value).padStart(2, '0')
---

<section class="wiki-browser" aria-label="Wiki 条目">
  <div class="wiki-tools">
    <label class="wiki-search">
      <span>SEARCH / 检索</span>
      <input type="search" placeholder="输入关键词" />
      <b>{pad(entries.length)}</b>
    </label>
    <div class="wiki-tags" aria-label="筛选标签">
      {
        tags.map((tag) => (
          <button type="button" class:list={{ 'is-active': tag === 'ALL' }} data-tag={tag}>
            {tag}
          </button>
        ))
      }
    </div>
    <span class="wiki-source">SOURCE / STATIC INDEX</span>
  </div>

  <div class="wiki-grid">
    {
      entries.map((entry) => (
        <a
          class="wiki-card"
          href={`/wiki/${entry.id}/`}
          data-tag={entry.data.tags[0].toUpperCase()}
          data-search={`${entry.data.title} ${entry.data.summary} ${entry.data.tags.join(' ')}`.toLowerCase()}
        >
          <div class="wiki-card-meta">
            <span>{entry.data.no}</span>
            <b>{entry.data.tags[0]}</b>
          </div>
          <h2>{entry.data.title}</h2>
          <p>{entry.data.summary}</p>
          <footer>
            <span>MLIN WIKI</span>
            <i>↗</i>
          </footer>
        </a>
      ))
    }
  </div>

  <div class="empty-state" style="display: none;">
    <strong>NO MATCHING RECORD</strong>
    <p>没有找到对应条目，试试更短的关键词。</p>
  </div>
</section>

<script>
  const browser = document.querySelector<HTMLElement>('.wiki-browser')
  const input = browser?.querySelector<HTMLInputElement>('.wiki-search input')
  const count = browser?.querySelector<HTMLElement>('.wiki-search b')
  const empty = browser?.querySelector<HTMLElement>('.empty-state')

  if (browser && input && count && empty) {
    const buttons = Array.from(browser.querySelectorAll<HTMLButtonElement>('.wiki-tags button'))
    const cards = Array.from(browser.querySelectorAll<HTMLElement>('.wiki-card'))
    let tag = 'ALL'

    const apply = () => {
      const keyword = input.value.trim().toLowerCase()
      let visible = 0
      for (const card of cards) {
        const show =
          (tag === 'ALL' || card.dataset.tag === tag) &&
          (!keyword || (card.dataset.search ?? '').includes(keyword))
        card.style.display = show ? '' : 'none'
        if (show) visible += 1
      }
      count.textContent = String(visible).padStart(2, '0')
      empty.style.display = visible === 0 ? '' : 'none'
    }

    for (const button of buttons) {
      button.addEventListener('click', () => {
        tag = button.dataset.tag ?? 'ALL'
        for (const other of buttons) other.classList.toggle('is-active', other === button)
        apply()
      })
    }
    input.addEventListener('input', apply)
  }
</script>
