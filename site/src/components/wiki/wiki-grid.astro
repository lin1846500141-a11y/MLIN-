---
// 自 frontend/components/wiki/wiki-grid.tsx 平移（M1）。
// 差异：数据改为构建期注入（wikiFallback）；fetch /api/wiki 与 motion 动画不再有——
// M3 落地 src/pages/api/wiki.json.ts 静态接口，M4 迁内容集合。
// 过滤逻辑（标签 + 关键词）以 vanilla 脚本保留，行为与旧站一致。
import { wikiFallback } from '../../lib/archive-data'

const allTag = 'ALL'
const items = wikiFallback
const tags = [allTag, ...Array.from(new Set(items.map((item) => item.tag.toUpperCase())))]
const searchBlob = (item: (typeof items)[number]) =>
  `${item.title} ${item.desc} ${item.tag}`.toLowerCase()
---

<section class="wiki-browser" aria-label="Wiki 条目">
  <div class="wiki-tools">
    <label class="wiki-search">
      <span>SEARCH / 检索</span>
      <input type="search" placeholder="输入关键词" />
      <b>{String(items.length).padStart(2, '0')}</b>
    </label>
    <div class="wiki-tags" aria-label="筛选标签">
      {
        tags.map((item) => (
          <button class={item === allTag ? 'is-active' : undefined} type="button">
            {item}
          </button>
        ))
      }
    </div>
    <span class="wiki-source">SOURCE / LOCAL INDEX</span>
  </div>

  <div class="wiki-grid">
    {
      items.map((item, index) => (
        <article
          class="wiki-card"
          data-tag={item.tag.toUpperCase()}
          data-search={searchBlob(item)}
        >
          <div class="wiki-card-meta">
            <span>{item.index ?? String(index + 1).padStart(2, '0')}</span>
            <b>{item.tag}</b>
          </div>
          <h2>{item.title}</h2>
          <p>{item.desc}</p>
          <footer>
            <span>MLIN WIKI</span>
            <i>↗</i>
          </footer>
        </article>
      ))
    }
  </div>

  <div class="empty-state" style="display: none;">
    <strong>NO MATCHING RECORD</strong>
    <p>没有找到对应条目，试试更短的关键词。</p>
  </div>
</section>

<script>
  const browser = document.querySelector('.wiki-browser')
  const input = browser?.querySelector<HTMLInputElement>('.wiki-search input')
  const count = browser?.querySelector('.wiki-search b')
  const empty = browser?.querySelector<HTMLElement>('.empty-state')
  const tagButtons = [...(browser?.querySelectorAll<HTMLButtonElement>('.wiki-tags button') ?? [])]
  const cards = [...(browser?.querySelectorAll<HTMLElement>('.wiki-card') ?? [])]

  if (browser && input && count && empty) {
    let tag = 'ALL'

    const apply = () => {
      const keyword = input.value.trim().toLowerCase()
      let visible = 0

      for (const card of cards) {
        const matchesTag = tag === 'ALL' || card.dataset.tag === tag
        const matchesKeyword = !keyword || (card.dataset.search ?? '').includes(keyword)
        const show = matchesTag && matchesKeyword
        card.style.display = show ? '' : 'none'
        if (show) visible += 1
      }

      count.textContent = String(visible).padStart(2, '0')
      empty.style.display = visible === 0 ? '' : 'none'
    }

    input.addEventListener('input', apply)

    for (const button of tagButtons) {
      button.addEventListener('click', () => {
        tag = (button.textContent ?? 'ALL').trim()
        for (const other of tagButtons) {
          other.classList.toggle('is-active', other === button)
        }
        apply()
      })
    }
  }
</script>
