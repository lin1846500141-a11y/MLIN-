---

<Base
  title="DESKSPACE / 外设灵感库"
  description="精选客制化桌面与磁轴硬件美学分享社区 — 探索全球硬核玩家的纯粹冷调搭配灵感。"
  image="/media/deskspace-banner.webp"
>
  <main class="deskspace-page">
    <!-- 顶部横幅：溶入 1779272120708 主视觉 + DESKSPACE / 外设灵感库 -->
    <section class="desk-hero" aria-labelledby="desk-title">
      <div class="desk-hero-art" aria-hidden="true">
        <img
          src="/media/deskspace-banner.webp"
          alt=""
          width="1920"
          height="960"
          loading="eager"
          fetchpriority="high"
        />
        <div class="desk-hero-mask"></div>
      </div>

      <div class="desk-hero-inner">
        <div class="desk-hero-copy">
          <span class="desk-hero-tick" aria-hidden="true"></span>
          <h1 id="desk-title">DESKSPACE / 外设灵感库</h1>
          <p class="desk-hero-sub">精选客制化桌面与硬件美学分享社区</p>
          <p class="desk-hero-desc">探索全球硬核玩家的纯粹冷调搭配灵感</p>
        </div>

        <aside class="desk-hero-aside" aria-hidden="true">
          <i></i>
          <span>GEAR</span>
          <span>PEOPLE</span>
          <span>A BETTER</span>
          <span>DESK LIFE</span>
        </aside>
      </div>
    </section>

    <!-- 分类胶囊栏 + 搜索框 + 布局切换 -->
    <section class="desk-toolbar" aria-label="外设分类与搜索">
      <div class="desk-tabs" role="tablist" aria-label="外设分类">
        {
          categories.map((cat, idx) => (
            <button
              type="button"
              role="tab"
              class={`desk-tab ${idx === 0 ? 'is-active' : ''}`}
              aria-selected={idx === 0 ? 'true' : 'false'}
              data-category={cat.id}
            >
              {cat.label}
            </button>
          ))
        }
      </div>

      <div class="desk-tools-right">
        <label class="desk-search">
          <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
            <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="1.8" />
            <path d="M16.2 16.2L21 21" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
          </svg>
          <input
            id="desk-search-input"
            type="search"
            placeholder="搜索套件、磁轴、RT参数、玩家晒单..."
            autocomplete="off"
          />
        </label>

        <button
          type="button"
          class="desk-layout-btn"
          id="desk-layout-toggle"
          aria-label="切换卡片网格密度"
          title="切换网格视图"
        >
          <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true">
            <rect x="2.5" y="3.5" width="4" height="3" rx="0.8" fill="currentColor" />
            <rect x="8" y="3.5" width="9.5" height="3" rx="0.8" fill="currentColor" />
            <rect x="2.5" y="8.5" width="4" height="3" rx="0.8" fill="currentColor" />
            <rect x="8" y="8.5" width="9.5" height="3" rx="0.8" fill="currentColor" />
            <rect x="2.5" y="13.5" width="4" height="3" rx="0.8" fill="currentColor" />
            <rect x="8" y="13.5" width="9.5" height="3" rx="0.8" fill="currentColor" />
          </svg>
        </button>
      </div>
    </section>

    <!-- 晒单评价卡片网格（2行4列不对称杂志磨砂毛玻璃卡片） -->
    <section class="desk-grid-wrap" aria-label="玩家外设晒单与评价">
      <div class="desk-grid" id="desk-grid">
        {
          deskCards.map((card) => (
            <article
              class={`desk-card span-${card.span}`}
              data-category={card.category}
              data-card-id={card.id}
              data-search={`${card.title} ${card.subtitle} ${card.category} ${card.specs.kit} ${card.specs.switchName} ${card.specs.rt} ${card.reviewSummary}`.toLowerCase()}
            >
              <div class="desk-card-media" data-open-review={card.id} role="button" tabindex="0" aria-label={`查看 ${card.title} 晒单评价与实拍图`}>
                <img
                  class="desk-card-img"
                  src={card.cover}
                  alt={card.title}
                  width="600"
                  height="380"
                  loading="lazy"
                />
                <div class="desk-card-shade" aria-hidden="true" />

                <!-- 右上角三点按钮 + 相册缩略图切换指示 -->
                <div class="desk-card-top">
                  <span class="desk-card-badge">{card.specs.switchName.split('·')[0].trim()}</span>
                  <button
                    type="button"
                    class="desk-card-more"
                    data-open-review={card.id}
                    aria-label="查看晒单配置与玩家真实评价"
                    title="点击查看完整多图评价与 RT 配置"
                  >
                    •••
                  </button>
                </div>

                <!-- 卡片内部多图缩略快速预览条（鼠标悬停或点击小图即刻切换实拍角度） -->
                <div class="desk-card-thumbs" aria-label="实拍多图切换">
                  {card.gallery.map((photo, pIdx) => (
                    <button
                      type="button"
                      class={`desk-thumb-dot ${pIdx === 0 ? 'is-active' : ''}`}
                      data-photo={photo}
                      aria-label={`切换实拍图 ${pIdx + 1}`}
                    >
                      <img src={photo} alt="" loading="lazy" />
                    </button>
                  ))}
                </div>

                <!-- 图片左下方标题与真实评价摘要 -->
                <div class="desk-card-caption">
                  <div class="desk-card-title-row">
                    <h2>{card.title.split('·')[0].trim()}</h2>
                    <span class="desk-card-sub">{card.title.split('·')[1]?.trim()}</span>
                  </div>
                  <p class="desk-card-snippet">{card.reviewSummary}</p>
                </div>
              </div>

              <!-- 底部作者头像 + 点赞 + 评论数 + 分享 -->
              <footer class="desk-card-foot">
                <button type="button" class="desk-author" data-open-review={card.id}>
                  <img src={card.avatar} alt={card.author} width="26" height="26" loading="lazy" />
                  <span class="desk-author-name">{card.author}</span>
                </button>

                <div class="desk-metrics">
                  <button
                    type="button"
                    class="desk-metric-btn desk-like-btn"
                    data-likes={card.likes}
                    aria-pressed="false"
                    aria-label="点赞晒单"
                  >
                    <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
                      <path
                        d="M12 20.4l-1.45-1.32C5.4 14.36 2 11.28 2 7.5 2 4.42 4.42 2 7.5 2c1.74 0 3.41.81 4.5 2.09C13.09 2.81 14.76 2 16.5 2 19.58 2 22 4.42 22 7.5c0 3.78-3.4 6.86-8.55 11.54L12 20.4z"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                      />
                    </svg>
                    <span>{card.likesLabel}</span>
                  </button>

                  <button
                    type="button"
                    class="desk-metric-btn desk-comment-btn"
                    data-open-review={card.id}
                    aria-label="查看玩家评论"
                  >
                    <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
                      <path
                        d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linejoin="round"
                      />
                    </svg>
                    <span>{card.commentsCount}</span>
                  </button>

                  <button
                    type="button"
                    class="desk-metric-btn desk-share-btn"
                    data-open-review={card.id}
                    aria-label="分享配置单"
                  >
                    <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
                      <circle cx="18" cy="5" r="3" fill="none" stroke="currentColor" stroke-width="1.8" />
                      <circle cx="6" cy="12" r="3" fill="none" stroke="currentColor" stroke-width="1.8" />
                      <circle cx="18" cy="19" r="3" fill="none" stroke="currentColor" stroke-width="1.8" />
                      <path d="M8.59 13.51l6.83 3.98M15.41 6.51l-6.82 3.98" fill="none" stroke="currentColor" stroke-width="1.8" />
                    </svg>
                  </button>
                </div>
              </footer>
            </article>
          ))
        }
      </div>
    </section>

    <footer class="desk-footer">
      <span>DESKSPACE / MAGNETIC SWITCH &amp; CUSTOM GEAR COMMUNITY</span>
      <strong>MLINStudio</strong>
    </footer>

    <!-- 点击任一卡片弹出的「玩家实拍多图 + 硬件配置铭牌 + 真实评价」磨砂毛玻璃详情抽屉 -->
    <div class="desk-modal-backdrop" id="desk-modal" hidden>
      <div class="desk-modal-panel" role="dialog" aria-modal="true" aria-labelledby="desk-modal-title">
        <button type="button" class="desk-modal-close" id="desk-modal-close" aria-label="关闭晒单详情">
          ✕
        </button>

        <div class="desk-modal-grid">
          <div class="desk-modal-gallery">
            <div class="desk-modal-main-img">
              <img id="desk-modal-img" src="/media/deskspace/rig-ice-1.webp" alt="" />
            </div>
            <div class="desk-modal-thumbs" id="desk-modal-thumbs"></div>
          </div>

          <div class="desk-modal-info">
            <div class="desk-modal-head">
              <span class="desk-modal-cat" id="desk-modal-cat">机械键盘</span>
              <h3 id="desk-modal-title">Ocean Mirage</h3>
              <p class="desk-modal-sub" id="desk-modal-sub"></p>
            </div>

            <dl class="desk-modal-specs" id="desk-modal-specs"></dl>

            <div class="desk-modal-review-box">
              <h4>机主实测体验</h4>
              <p id="desk-modal-summary"></p>
            </div>

            <div class="desk-modal-comments">
              <h4>玩家真实晒图评价</h4>
              <div class="desk-modal-comment-list" id="desk-modal-comments"></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <script
      id="desk-cards-data"
      type="application/json"
      set:html={JSON.stringify(deskCards)}
    />
  </main>
</Base>

<script>
  const cardsDataEl = document.getElementById('desk-cards-data')
  const cardsData = cardsDataEl ? JSON.parse(cardsDataEl.textContent || '[]') : []
  const cardsById = new Map<string, any>(cardsData.map((c: any) => [c.id, c]))

  // 1. 分类胶囊筛选 + 搜索过滤
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.desk-tab'))
  const searchInput = document.getElementById('desk-search-input') as HTMLInputElement | null
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.desk-card'))
  let activeCategory = 'all'

  const applyFilter = () => {
    const q = (searchInput?.value || '').trim().toLowerCase()
    cards.forEach((card) => {
      const cat = card.dataset.category || ''
      const hay = card.dataset.search || ''
      const catMatch = activeCategory === 'all' || cat === activeCategory
      const qMatch = !q || hay.includes(q)
      card.style.display = catMatch && qMatch ? '' : 'none'
    })
  }

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      tabs.forEach((t) => {
        t.classList.remove('is-active')
        t.setAttribute('aria-selected', 'false')
      })
      tab.classList.add('is-active')
      tab.setAttribute('aria-selected', 'true')
      activeCategory = tab.dataset.category || 'all'
      applyFilter()
    })
  })

  searchInput?.addEventListener('input', applyFilter)

  // 2. 网格密度切换
  const grid = document.getElementById('desk-grid')
  const layoutBtn = document.getElementById('desk-layout-toggle')
  layoutBtn?.addEventListener('click', () => {
    grid?.classList.toggle('is-uniform')
    layoutBtn.classList.toggle('is-active')
  })

  // 3. 卡片内部多图缩略点切换（不用打开弹窗也能直接在卡片上切 3 张实拍图）
  cards.forEach((card) => {
    const mainImg = card.querySelector<HTMLImageElement>('.desk-card-img')
    const thumbBtns = Array.from(card.querySelectorAll<HTMLButtonElement>('.desk-thumb-dot'))
    thumbBtns.forEach((btn) => {
      const switchPhoto = (e: Event) => {
        e.stopPropagation()
        const photo = btn.dataset.photo
        if (photo && mainImg) {
          mainImg.src = photo
          thumbBtns.forEach((b) => b.classList.remove('is-active'))
          btn.classList.add('is-active')
        }
      }
      btn.addEventListener('click', switchPhoto)
      btn.addEventListener('mouseenter', switchPhoto)
    })
  })

  // 4. 点赞微交互（带弹性反馈）
  document.querySelectorAll<HTMLButtonElement>('.desk-like-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation()
      const liked = btn.getAttribute('aria-pressed') === 'true'
      const next = !liked
      btn.setAttribute('aria-pressed', String(next))
      btn.classList.toggle('is-liked', next)
      const base = Number(btn.dataset.likes || 0)
      const countEl = btn.querySelector('span')
      if (countEl && base < 1000) {
        countEl.textContent = String(next ? base + 1 : base)
      }
    })
  })

  // 5. 点击卡片打开玩家真实晒单详情弹窗
  const modal = document.getElementById('desk-modal')
  const modalClose = document.getElementById('desk-modal-close')
  const modalImg = document.getElementById('desk-modal-img') as HTMLImageElement | null
  const modalThumbs = document.getElementById('desk-modal-thumbs')
  const modalCat = document.getElementById('desk-modal-cat')
  const modalTitle = document.getElementById('desk-modal-title')
  const modalSub = document.getElementById('desk-modal-sub')
  const modalSpecs = document.getElementById('desk-modal-specs')
  const modalSummary = document.getElementById('desk-modal-summary')
  const modalComments = document.getElementById('desk-modal-comments')

  const openModal = (id: string) => {
    const data = cardsById.get(id)
    if (!data || !modal) return
    if (modalImg) modalImg.src = data.gallery[0] || data.cover
    if (modalCat) modalCat.textContent = data.category
    if (modalTitle) modalTitle.textContent = data.title
    if (modalSub) modalSub.textContent = data.subtitle
    if (modalSummary) modalSummary.textContent = data.reviewSummary

    if (modalThumbs) {
      modalThumbs.innerHTML = (data.gallery || [])
        .map(
          (src: string, idx: number) =>
            `<button type="button" class="desk-modal-thumb ${idx === 0 ? 'is-active' : ''}" data-src="${src}"><img src="${src}" alt="实拍图 ${idx + 1}" /></button>`,
        )
        .join('')
      modalThumbs.querySelectorAll<HTMLButtonElement>('.desk-modal-thumb').forEach((tBtn) => {
        tBtn.addEventListener('click', () => {
          if (modalImg && tBtn.dataset.src) modalImg.src = tBtn.dataset.src
          modalThumbs.querySelectorAll('.desk-modal-thumb').forEach((b) => b.classList.remove('is-active'))
          tBtn.classList.add('is-active')
        })
      })
    }

    if (modalSpecs && data.specs) {
      modalSpecs.innerHTML = `
        <div><dt>套件外壳</dt><dd>${data.specs.kit}</dd></div>
        <div><dt>搭载磁轴</dt><dd>${data.specs.switchName}</dd></div>
        <div><dt>RT 行程参数</dt><dd>${data.specs.rt}</dd></div>
        <div><dt>键帽搭配</dt><dd>${data.specs.keycaps}</dd></div>
      `
    }

    if (modalComments) {
      modalComments.innerHTML = (data.reviews || [])
        .map(
          (r: any) => `
          <div class="desk-comment-item">
            <div class="desk-comment-meta">
              <strong>${r.user}</strong>
              <span>${r.role}</span>
              <time>${r.time}</time>
            </div>
            <p>${r.text}</p>
            ${
              r.photos && r.photos.length
                ? `<div class="desk-comment-photos">${r.photos.map((p: string) => `<img src="${p}" alt="买家评价晒图" />`).join('')}</div>`
                : ''
            }
          </div>
        `,
        )
        .join('')
    }

    modal.hidden = false
    document.body.style.overflow = 'hidden'
  }

  const closeModal = () => {
    if (!modal) return
    modal.hidden = true
    document.body.style.overflow = ''
  }

  document.querySelectorAll<HTMLElement>('[data-open-review]').forEach((el) => {
    el.addEventListener('click', (e) => {
      e.stopPropagation()
      const id = el.dataset.openReview
      if (id) openModal(id)
    })
  })

  modalClose?.addEventListener('click', closeModal)
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal()
  })
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && !modal.hidden) closeModal()
  })
</script>
