    "vinext": "^1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.3",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
