---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';

const skills = [
  { no: '01', en: 'PC HARDWARE', zh: '电脑配置 / 台式机组装', desc: '根据用途搭配硬件，完成整机装配。' },
  { no: '02', en: 'SMT EQUIPMENT', zh: '贴片机操作', desc: '松下、西门子、富士贴片机。' },
  { no: '03', en: 'DIE BONDER', zh: '固晶机操作', desc: '新益昌固晶机。' },
  { no: '04', en: 'AI DEVELOPMENT', zh: 'AI 开发', desc: '持续学习，把想法做成可以运行的作品。' },
];
---

<BaseLayout title="About" description="关于 MLINStudio：硬件、设备与 AI 开发实践。">
  <main>
    <PageIntro
      index="05"
      eyebrow="PERSONNEL FILE"
      title="ABOUT"
      titleZh="关于"
      lede="会配电脑，也会操作生产线设备。现在正把对机器的理解，慢慢延伸到 AI 与界面开发。"
    />

    <section class="about-portrait" aria-label="个人简介">
      <div class="about-photo" data-reveal>
        <img src="/media/coastal-hero.webp" alt="沿海小镇与蓝色海面" loading="lazy" />
        <span>PLACE / SOUTH COAST</span>
        <b>22.16° N</b>
      </div>
      <div class="about-statement">
        <span class="kicker" data-reveal>PROFILE / 001</span>
        <h2 class="display" data-reveal>OPERATOR.<br />BUILDER.<br /><i>AI CURIOUS.</i></h2>
        <p data-reveal>
          这里记录的不是一个已经完成的身份，而是几条正在交汇的路线：实体设备、电脑硬件、AI 开发与视觉表达。
        </p>
      </div>
    </section>

    <section class="capability-section">
      <header data-reveal>
        <span class="kicker">01 — CAPABILITIES</span>
        <h2 class="display">WHAT I CAN DO</h2>
        <b>技能档案</b>
      </header>
      <div class="capability-list">
        {
          skills.map((s) => (
            <article data-reveal>
              <span>{s.no}</span>
              <b>{s.en}</b>
              <h3>{s.zh}</h3>
              <p>{s.desc}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="experience-section">
      <header data-reveal>
        <span class="kicker">02 — WORK HISTORY</span>
        <h2 class="display">EXPERIENCE</h2>
        <b>工作经历</b>
      </header>
      <article data-reveal>
        <time>2025.08 — 2026.05</time>
        <div>
          <h3>广东晶科电子有限公司</h3>
          <p>GUANGDONG JINGKE ELECTRONICS CO., LTD.</p>
        </div>
        <strong>01</strong>
      </article>
    </section>

    <footer class="inner-footer"><span>RECORD TO BE CONTINUED</span><b>MLINStudio</b></footer>
  </main>
</BaseLayout>
